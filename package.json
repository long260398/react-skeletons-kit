{
  "name": "react-skeletons-kit",
  "version": "0.1.0",
  "description": "Zero-dependency skeleton loading components for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^5.0.2"
  },
  "keywords": ["react", "skeleton", "loading", "placeholder", "typescript", "ui"],
  "author": "long260398",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/long260398/react-loading-skeleton"
  },
  "homepage": "https://github.com/long260398/react-loading-skeleton#readme"
}
